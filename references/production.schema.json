{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bengali Medical Case-to-Video Production Package v2.2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.2.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{2,79}$"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "evidence_state": {
      "enum": [
        "PLANNED",
        "TESTED",
        "FAILED",
        "VERIFIED",
        "USER-APPROVED"
      ]
    },
    "stage": {
      "enum": [
        "INTAKE",
        "FACT_REGISTER",
        "CLINICAL_AUDIT",
        "SCREENPLAY",
        "BIBLES",
        "KEYFRAME",
        "MANIFEST",
        "PILOT_QA",
        "FULL_PRODUCTION",
        "FINAL_AUDIT"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "clip_count": {
          "type": "integer",
          "minimum": 1
        },
        "clip_duration_s": {
          "type": "number",
          "minimum": 0
        },
        "aspect_ratio": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "style": {
          "type": "string"
        }
      },
      "required": [
        "duration_s",
        "clip_count",
        "clip_duration_s",
        "aspect_ratio",
        "language",
        "style"
      ],
      "additionalProperties": false
    },
    "clinical_scope_id": {
      "type": "string"
    },
    "clinical_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "script_scope_id": {
      "type": "string"
    },
    "script_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "production_scope_id": {
      "type": "string"
    },
    "release_scope_id": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "creative_choices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clip"
      }
    },
    "pilot_clip_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkpoint"
      }
    },
    "assembly": {
      "type": "object",
      "properties": {
        "output": {
          "$ref": "#/$defs/file"
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "qa_result": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_TESTED",
            "EXCEPTION",
            "STALE"
          ]
        },
        "review_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "release_state": {
          "enum": [
            "HOLD",
            "APPROVED"
          ]
        },
        "input_contract_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "output",
        "duration_s",
        "qa_result",
        "review_evidence",
        "release_state",
        "input_contract_sha256"
      ],
      "additionalProperties": false
    },
    "production_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "render_authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quoted_credits_per_output": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_total_credits": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_attempts_per_clip": {
          "type": "integer",
          "minimum": 1
        },
        "current_quote_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorized_clip_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner_approval_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
